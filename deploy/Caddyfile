# Dirección http://IP para la demo, o dominio para HTTPS automático.
{$BALTO_SITE_ADDRESS} {
	encode zstd gzip

	# Se publican los webhooks de chat y Telegram. El editor y la API de n8n
	# permanecen en 127.0.0.1:5678 y no se enrutan desde internet.
	@chat {
		path /webhook/chat
		method POST OPTIONS
	}
	handle @chat {
		request_body {
			max_size 8KB
		}
		reverse_proxy n8n:5678
	}

	@telegram_bot {
		path /webhook/balto-bot-webhook/webhook
		method POST
	}
	handle @telegram_bot {
		reverse_proxy n8n:5678
	}

	handle {
		reverse_proxy drupal:80
	}
}
