<?php

/**
 * @file
 * Variables de presentación. Los contenidos provienen del módulo y MariaDB.
 */

/** Implements hook_preprocess_page(). */
function vet_theme_preprocess_page(array &$variables): void {
  $variables['business'] = \Drupal::service('vet_api.business')->getBusiness();
  $theme_path = \Drupal::service('extension.list.theme')->getPath('vet_theme');
  $variables['vet_assets'] = base_path() . $theme_path;
  $has_uploaded_logo = is_file(DRUPAL_ROOT . '/' . $theme_path . '/images/logo.png');
  $variables['vet_real_logo'] = $has_uploaded_logo;
  $variables['vet_logo_crop'] = FALSE;
  $variables['vet_logo'] = $variables['vet_assets'] . '/images/'
    . (is_file(DRUPAL_ROOT . '/' . $theme_path . '/images/logo.png') ? 'logo.png' : 'logo-placeholder.svg');
  $gallery = \Drupal::service('vet_api.clinic_gallery')->get();
  if (!$has_uploaded_logo && $gallery['logo']) {
    $variables['vet_logo'] = $gallery['logo']['original_url'];
    $variables['vet_logo_crop'] = TRUE;
    $variables['vet_real_logo'] = TRUE;
  }
  $variables['vet_year'] = date('Y');
  $variables['cart_count'] = [
    '#lazy_builder' => ['\\Drupal\\vet_api\\Render\\CartCount::build', []],
    '#create_placeholder' => TRUE,
  ];
  $variables['payment_methods'] = _vet_theme_payment_methods($variables['business']['payment_methods'] ?? '');
  // La disponibilidad de Culqi depende de la pasarela: se invalida al cambiarla.
  $variables['#cache']['tags'][] = 'config:commerce_payment_gateway_list';
}

/**
 * Medios de pago para la franja informativa del pie de página.
 *
 * "available" refleja el estado real del comercio: nunca se marca
 * PagoEfectivo/Culqi como disponible salvo que la pasarela exista,
 * esté activa y sus credenciales del entorno configurado sean válidas.
 */
function _vet_theme_payment_methods(string $local_methods = ''): array {
  $methods = [
    [
      'icon' => 'clock',
      'label' => 'Pago simulado',
      'note' => 'Para la demo académica — no se realiza ningún cobro real.',
      'available' => TRUE,
    ],
    [
      'icon' => 'bag',
      'label' => 'Pago al recoger en tienda',
      // Se usan los medios confirmados por el propietario en Datos del negocio.
      'note' => trim($local_methods) !== '' ? trim($local_methods) : 'Consulta los medios aceptados en el local.',
      'available' => TRUE,
    ],
    [
      'icon' => 'chat',
      'label' => 'Yape o transferencia coordinada',
      'note' => 'Coordinas el pago por WhatsApp antes de confirmar el pedido.',
      'available' => TRUE,
    ],
    [
      'icon' => 'phone',
      'label' => 'PagoEfectivo (código CIP)',
      'note' => 'Banca móvil, agentes o internet banking — próximamente vía Culqi.',
      'available' => FALSE,
    ],
  ];

  if (\Drupal::hasService('balto_payments.orders') && \Drupal::hasService('entity_type.manager')) {
    try {
      // Se busca por ID de plugin, no por ID de configuración: el gateway
      // puede llamarse distinto según cómo se haya creado (p. ej.
      // "culqi_automatico" en scripts/prepare-automatic-payments.php).
      $gateways = \Drupal::entityTypeManager()->getStorage('commerce_payment_gateway')->loadMultiple();
      foreach ($gateways as $gateway) {
        if ($gateway->getPluginId() !== 'balto_culqi_orders') {
          continue;
        }
        if ($gateway->status()) {
          \Drupal::service('balto_payments.orders')->credentials($gateway->getPlugin()->getMode());
          $methods[3]['available'] = TRUE;
          $methods[3]['note'] = 'Banca móvil, agentes o internet banking mediante código CIP — vía Culqi.';
        }
        break;
      }
    }
    catch (\Throwable) {
      // Sin credenciales válidas o pasarela desactivada: se mantiene "próximamente".
    }
  }

  return $methods;
}

/** Implements hook_preprocess_HOOK() for vet_home. */
function vet_theme_preprocess_vet_home(array &$variables): void {
  $variables['vet_assets'] = base_path() . \Drupal::service('extension.list.theme')->getPath('vet_theme');
  _vet_theme_attach_cart_forms($variables['featured_products']);
}

/** Datos de detalle desde las entidades de Commerce y su saldo de stock. */
function vet_theme_preprocess_commerce_product(array &$variables): void {
  if ($variables['product_entity']->bundle() === 'vet_product') {
    $variables['balto_product'] = \Drupal::service('vet_api.catalog')->present($variables['product_entity']);
    $variables['business'] = \Drupal::service('vet_api.business')->getBusiness();
  }
}

/** Implements hook_preprocess_HOOK() for vet_catalog. */
function vet_theme_preprocess_vet_catalog(array &$variables): void {
  $variables['vet_assets'] = base_path() . \Drupal::service('extension.list.theme')->getPath('vet_theme');
  _vet_theme_attach_cart_forms($variables['products']);
}

/**
 * Añade a cada tarjeta con existencias el formulario real de Commerce.
 *
 * Se usa el lazy builder de Commerce: el formulario se genera como
 * marcador de posición, así la caché de la página no comparte tokens ni
 * carritos entre visitantes. El stock se valida igual al enviar.
 */
function _vet_theme_attach_cart_forms(array &$items): void {
  $langcode = \Drupal::languageManager()->getCurrentLanguage()->getId();
  foreach ($items as &$item) {
    if (!empty($item['available']) && !empty($item['id'])) {
      $item['cart_form'] = [
        '#lazy_builder' => ['commerce_product.lazy_builders:addToCartForm', [$item['id'], 'default', TRUE, $langcode]],
        '#create_placeholder' => TRUE,
      ];
    }
  }
}
