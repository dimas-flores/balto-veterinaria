<section class="catalog-header balto-catalog-hero catalog-trial" aria-labelledby="catalog-title">
  <div class="catalog-intro-copy">
    <nav class="catalog-breadcrumb" aria-label="Ruta de navegación"><a href="{{ path('<front>') }}">Inicio</a><span aria-hidden="true">/</span><span aria-current="page">Tienda</span></nav>
    <h1 id="catalog-title">Tienda para mascotas</h1>
    <p>Alimentos, accesorios y productos de cuidado para perros y gatos.</p>
    <form class="catalog-hero-search" action="{{ path('vet_api.catalog') }}" method="get">
      <label for="catalog-hero-query">¿Qué buscas para tu mascota?</label>
      <div><input id="catalog-hero-query" type="search" name="q" value="{{ filters.q }}" placeholder="Busca alimento, collar…" maxlength="100" />
      {% if filters.category %}<input type="hidden" name="category" value="{{ filters.category }}" />{% endif %}
      {% if filters.species %}<input type="hidden" name="species" value="{{ filters.species }}" />{% endif %}
      <button type="submit" class="button">Buscar {% include '@vet_theme/templates/icon.html.twig' with {icon: 'search'} only %}</button></div>
    </form>
  </div>
  <div class="catalog-cover" aria-hidden="true"></div>
</section>
<nav class="catalog-categories" aria-label="Explorar categorías"><a href="{{ path('vet_api.catalog') }}"{% if not filters.category %} aria-current="page"{% endif %}>Todo el catálogo</a>{% for id, label in categories %}<a href="{{ path('vet_api.catalog', {}, {'query': {'category': id}}) }}"{% if filters.category == id %} aria-current="page"{% endif %}>{{ label }}</a>{% endfor %}</nav>
{% if business.catalog_is_example %}<div class="catalog-demo-notice"><span class="demo-indicator"></span><p><strong>Catálogo de demostración.</strong> Productos, precios y existencias de ejemplo. Las fotos son referenciales y no muestran el producto exacto.</p></div>{% endif %}
<div class="catalog-layout">
  <aside class="catalog-sidebar" aria-label="Filtros del catálogo">
    <details class="catalog-filter-disclosure" open><summary>Filtrar productos <span aria-hidden="true">+</span></summary><form class="catalog-filters" method="get" action="{{ path('vet_api.catalog') }}">
      <h2>Encuentra lo que necesita</h2>
      {% if filters.q %}<input type="hidden" name="q" value="{{ filters.q }}" />{% endif %}
      <div class="catalog-filter-field"><label for="catalog-category">Categoría</label><select id="catalog-category" name="category"><option value="">Todas las categorías</option>{% for id, label in categories %}<option value="{{ id }}"{% if filters.category == id %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></div>
      <div class="catalog-filter-field"><label for="catalog-species">¿Para quién?</label><select id="catalog-species" name="species"><option value="">Todas las mascotas</option>{% for id, label in species_options %}<option value="{{ id }}"{% if filters.species == id %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></div>
      <button class="button" type="submit">Aplicar filtros <span aria-hidden="true">↗</span></button>
      {% if filters.q or filters.category or filters.species %}<a class="clear-filters" href="{{ path('vet_api.catalog') }}">Limpiar filtros</a>{% endif %}
    </form></details>

  </aside>
  <section class="catalog-results" aria-labelledby="results-title">
    <div class="catalog-results-heading"><h2 id="results-title">{% if filters.q %}Resultados de “{{ filters.q }}”{% else %}Productos para tu mascota{% endif %}</h2><p><strong>{{ total }}</strong> {{ total == 1 ? 'producto' : 'productos' }}{% if total > 12 %} · {{ products|length }} en esta página{% endif %}</p></div>
    {% if products %}<div class="product-grid">{% for item in products %}
      {% include '@vet_theme/templates/product-card.html.twig' with {item: item} only %}
    {% endfor %}</div><div class="catalog-pager">{{ pager }}</div>{% else %}<div class="catalog-empty">{% include '@vet_theme/templates/icon.html.twig' with {icon: 'bag'} only %}<h3>No encontramos coincidencias.</h3><p>Prueba con otro nombre o limpia los filtros.</p><a class="button" href="{{ path('vet_api.catalog') }}">Ver todos los productos</a></div>{% endif %}
  </section>
</div>
