{#
  Mensajes de Drupal con clases por tipo. Los de estado se muestran como
  notificación flotante (js/cart-feedback.js); los errores quedan en la página.
#}
<div data-drupal-messages>
{% for type, messages in message_list %}
  {% set role = type == 'error' ? 'alert' : 'status' %}
  <div class="messages messages--{{ type }}" role="{{ role }}" aria-label="{{ status_headings[type] }}">
    {% if status_headings[type] %}<h2 class="visually-hidden">{{ status_headings[type] }}</h2>{% endif %}
    {% if messages|length > 1 %}
      <ul>{% for message in messages %}<li>{{ message }}</li>{% endfor %}</ul>
    {% else %}
      {{ messages|first }}
    {% endif %}
  </div>
{% endfor %}
</div>
