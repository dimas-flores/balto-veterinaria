{% set assets = vet_assets %}
{# Portada fija: las guías para clínicas recomiendan un inicio estático en vez de carrusel. #}
<section class="hero hero-carousel balto-hero" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-copy">
      <h1 id="hero-title">{% if business.slogan == 'Medicina para tu mascota' %}Medicina para<br />tu <em>mascota.</em>{% else %}{{ business.slogan }}{% endif %}</h1>
      <p class="hero-description">Consulta veterinaria, vacunas, cirugía y hospitalización en Juliaca.</p>
      <div class="hero-actions"><a class="button" href="{{ business.appointment_url }}" target="_blank" rel="noopener noreferrer">{% include '@vet_theme/templates/icon.html.twig' with {icon: 'whatsapp'} only %} Separar cita por WhatsApp</a><a class="text-link" href="{{ path('vet_api.catalog') }}">Ver tienda</a></div>
      {# Datos publicados por BALTO en sus redes: marcas de vacunas y monitoreo en cirugía. #}
      <p class="hero-trust">Hospitalización las {{ business.hospitalization }}, vacunas MSD, Zoetis y Nobivac, y quirófano con monitoreo.</p>
    </div>
    <div class="hero-visual">
      <div class="hero-image{% if clinic_gallery.portada %} hero-image-clinic{% endif %}">{% if clinic_gallery.portada %}<img src="{{ clinic_gallery.portada.image_url }}" width="{{ clinic_gallery.portada.width }}" height="{{ clinic_gallery.portada.height }}" alt="{{ clinic_gallery.portada.alt }}" fetchpriority="high" />{% else %}<img src="{{ assets }}/images/companeros.jpg" width="1500" height="1001" alt="Dos perros paseando juntos al aire libre" fetchpriority="high" />{% endif %}</div>
      {% set story = clinic_gallery.stories|first %}
      {% if story %}<a class="hero-story" href="#historias"><img src="{{ story.image_url }}" width="48" height="48" alt="" aria-hidden="true" loading="lazy" decoding="async" /><span><small>Historia de un paciente</small><strong>{{ story.title }}</strong></span></a>{% endif %}
      <a class="care-badge" href="{{ business.phone_url }}"><span class="care-badge-icon">{% include '@vet_theme/templates/icon.html.twig' with {icon: 'cross'} only %}</span><span><strong>Hospitalización {{ business.hospitalization }}</strong><small>¿Urgencia? Llama al {{ business.whatsapp }}</small></span></a>
    </div>
  </div>
</section>


<section id="servicios" class="section services-section" aria-labelledby="services-title">
  <div class="container">
    <div class="section-heading"><div><h2 id="services-title">Servicios veterinarios</h2></div></div>
    {% if business.service_pricing_note %}<div class="services-pricing-note"><p>{{ business.service_pricing_note }}</p></div>{% endif %}
    <div class="services-grid">
      {% for service in services %}
        <a class="service-card{% if service.icon == 'moon' %} service-card-featured{% endif %}" href="{{ service.url }}"><span class="service-icon">{% include '@vet_theme/templates/icon.html.twig' with {icon: service.icon} only %}</span><h3>{{ service.title }}</h3><p>{{ service.description }}</p></a>
      {% else %}<p class="empty-state">Estamos actualizando nuestros servicios. Escríbenos por WhatsApp para orientarte.</p>{% endfor %}
    </div>
  </div>
</section>

{# Fotos reales del equipo y los equipos de BALTO, tomadas de sus publicaciones de Facebook. #}
<section id="clinica" class="section clinic-work" aria-labelledby="clinic-work-title">
  <div class="container">
    <div class="section-heading"><div><h2 id="clinic-work-title">Así trabajamos</h2></div><p>Fotos de nuestro equipo en la clínica de Juliaca.</p></div>
    <div class="clinic-work-grid">
      {% for photo in [
        {file: 'clinica-cirugia', title: 'Cirugía', text: 'Quirófano equipado para esterilizaciones, fracturas y tejidos blandos.', alt: 'Veterinario de BALTO con uniforme quirúrgico verde en el quirófano'},
        {file: 'clinica-monitoreo', title: 'Monitoreo', text: 'Anestesia controlada y monitoreo durante toda la cirugía.', alt: 'Veterinario de BALTO revisando los monitores junto a un paciente anestesiado'},
        {file: 'clinica-ecografia', title: 'Ecografía', text: 'Ecografías en la clínica para un diagnóstico rápido.', alt: 'Veterinaria de BALTO realizando una ecografía'},
        {file: 'clinica-rayosx', title: 'Rayos X', text: 'Rayos X digital para apoyar la evaluación del paciente.', alt: 'Veterinario de BALTO ajustando el equipo de rayos X'},
      ] %}
        <figure class="clinic-work-card"><img src="{{ assets }}/images/{{ photo.file }}.jpg" width="640" height="480" alt="{{ photo.alt }}" loading="lazy" decoding="async" /><figcaption><strong>{{ photo.title }}</strong><span>{{ photo.text }}</span></figcaption></figure>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section retail-home" aria-labelledby="retail-title"><div class="container">
  <div class="retail-heading"><div><h2 id="retail-title">Tienda para mascotas</h2></div><a class="button" href="{{ path('vet_api.catalog') }}">Ver toda la tienda {% include '@vet_theme/templates/icon.html.twig' with {icon: 'bag'} only %}</a></div>
  <form class="retail-search" action="{{ path('vet_api.catalog') }}" method="get"><label for="home-product-search">¿Qué necesita tu mascota?</label><div><input id="home-product-search" type="search" name="q" maxlength="100" placeholder="Busca alimento, accesorios o cuidado…" /><button type="submit" aria-label="Buscar productos">{% include '@vet_theme/templates/icon.html.twig' with {icon: 'search'} only %}<span>Buscar</span></button></div></form>
  <nav class="retail-pets" aria-label="Comprar según tu mascota"><a href="{{ path('vet_api.catalog', {}, {'query': {'species': 'perro'}}) }}"><img class="retail-pet-photo" aria-hidden="true" src="{{ assets }}/images/para-perro.jpg" alt="" width="900" height="700" loading="lazy" /><span>Para tu perro</span><small>Alimentos, paseos y juegos</small></a><a href="{{ path('vet_api.catalog', {}, {'query': {'species': 'gato'}}) }}"><img class="retail-pet-photo" aria-hidden="true" src="{{ assets }}/images/para-gato-balto.jpg" alt="" width="900" height="700" loading="lazy" /><span>Para tu gato</span><small>Alimentos, higiene y accesorios</small></a></nav>
</div></section>

<section id="nosotros" class="about-section" aria-labelledby="about-title">
  <div class="container about-grid">
    {% if clinic_gallery.nosotros %}
      <figure class="about-photo">
        <img src="{{ clinic_gallery.nosotros.image_url }}" width="{{ clinic_gallery.nosotros.width }}" height="{{ clinic_gallery.nosotros.height }}" alt="{{ clinic_gallery.nosotros.alt }}" loading="lazy" decoding="async" />
        <figcaption><span class="photo-caption-mark" aria-hidden="true">{% include '@vet_theme/templates/icon.html.twig' with {icon: 'paw'} only %}</span><span>{{ clinic_gallery.nosotros.caption }}</span></figcaption>
      </figure>
    {% else %}
      <div class="about-mark" aria-hidden="true"><span>BALTO</span>{% include '@vet_theme/templates/icon.html.twig' with {icon: 'paw'} only %}<small>MEDICINA PARA TU MASCOTA</small></div>
    {% endif %}
    <div class="about-copy"><h2 id="about-title">{{ business.about_title }}</h2><p>{{ business.about_text }}</p>{% if clinic_gallery.nosotros %}<div class="about-commitment"><span aria-hidden="true">{% include '@vet_theme/templates/icon.html.twig' with {icon: 'heart'} only %}</span><p><strong>{{ clinic_gallery.nosotros.title }}</strong><span>Cercanía en la atención. Compromiso con cada paciente.</span></p></div>{% endif %}</div>
  </div>
</section>

{% if clinic_gallery.stories %}
<section id="historias" class="section stories-section" aria-labelledby="stories-title">
  <div class="container">
    <div class="section-heading"><div><h2 id="stories-title">Historias que<br /><em>nos acompañan.</em></h2></div><p>Pequeños pacientes, grandes historias.<br />Momentos compartidos por BALTO a lo largo del tiempo.</p></div>
    <div class="stories-grid">
      {% for story in clinic_gallery.stories %}
        <article class="story-card">
          <a class="story-photo story-photo-{{ loop.index }}" href="{{ story.original_url }}" target="_blank" rel="noopener noreferrer" aria-label="Ver fotografía completa: {{ story.title }}"><img src="{{ story.image_url }}" width="{{ story.width }}" height="{{ story.height }}" alt="{{ story.alt }}" loading="lazy" decoding="async" /></a>
          <div class="story-copy"><h3>{{ story.title }}</h3><p>{{ story.caption }}</p></div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}



<section id="ubicacion" class="section location-section" aria-labelledby="location-title"><div class="container"><div class="section-heading"><div><h2 id="location-title">Nos vemos<br /><em>en Juliaca.</em></h2></div><p>Dos sedes para encontrarnos.<br />Una misma razón: su bienestar.</p></div><div class="location-grid"><div class="locations-info">{% for address in business.addresses %}<article class="address-row"><div><h3>{{ loop.first ? 'Sede central' : 'Segunda sede' }}</h3><p>{{ address }}</p>{% if loop.first %}<a class="text-link" href="{{ business.maps_link }}" target="_blank" rel="noopener noreferrer">Cómo llegar</a>{% endif %}</div></article>{% endfor %}<div id="horarios" class="schedule-panel"><h3>{% include '@vet_theme/templates/icon.html.twig' with {icon: 'clock'} only %} Nuestros horarios</h3><div class="schedule-hospital"><span>Hospitalización</span><strong>{{ business.hospitalization }}</strong></div><div class="consultation-hours"><strong>Tienda y consultorio</strong>{% if business.schedule_is_example %}<span class="example-label">Horario de ejemplo · Por confirmar</span>{% endif %}<p>{{ business.consultation_schedule }}</p></div></div>{% if business.payment_methods %}<div class="local-payments"><h3>Medios de pago en el local</h3><p>{{ business.payment_methods }}.</p>{% if business.yape_number %}<p><strong>Yape:</strong> {{ business.yape_number }}</p>{% endif %}<small>Confirma disponibilidad y total por WhatsApp antes de pagar un pedido web.</small></div>{% endif %}</div><div class="map-wrap"><iframe title="Mapa de la sede central de BALTO Veterinaria en Juliaca" src="{{ business.map_url }}" width="640" height="560" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe><a class="map-caption" href="{{ business.maps_link }}" target="_blank" rel="noopener noreferrer">{% include '@vet_theme/templates/icon.html.twig' with {icon: 'pin'} only %} BALTO · Sede central <span class="map-caption-action">Cómo llegar</span></a></div></div></div></section>

<section id="contacto" class="contact-section"><div class="container contact-inner"><div><h2>Estamos para ti.<br /><em>Y para tu mascota.</em></h2><p>Separa tu cita o consulta por nuestros servicios.</p></div><a class="button" href="{{ business.appointment_url }}" target="_blank" rel="noopener noreferrer">{% include '@vet_theme/templates/icon.html.twig' with {icon: 'whatsapp'} only %} Separar cita por WhatsApp</a></div></section>
