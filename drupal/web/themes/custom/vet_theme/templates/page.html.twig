{% set root = path('<front>') %}
<div class="site-shell">
  <div class="utility-bar" role="region" aria-label="Contacto y ubicación">
    <div class="container utility-inner">
      <span class="utility-place">{% include '@vet_theme/templates/icon.html.twig' with {icon: 'pin'} only %} {{ business.city }}</span>
      <a href="{{ root }}#horarios"><span class="status-dot"></span> Hospitalización {{ business.hospitalization }}</a>
      <a class="utility-phone" href="{{ business.phone_url }}">{{ business.whatsapp }}</a>
    </div>
  </div>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand{% if vet_real_logo %} brand-real{% endif %}" href="{{ root }}" aria-label="{{ business.name }}: inicio">
        <span class="brand-symbol{% if vet_logo_crop %} brand-symbol-wolf{% endif %}"><img src="{{ vet_logo }}" width="48" height="52" alt="" /></span>
        <span><strong>BALTO<span class="brand-dot">.</span></strong><small>VETERINARIA</small></span>
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-navigation" aria-label="Abrir menú">
        {% include '@vet_theme/templates/icon.html.twig' with {icon: 'menu'} only %}
      </button>
      <nav id="main-navigation" class="main-navigation" aria-label="Navegación principal">
        <a href="{{ root }}"{% if is_front %} aria-current="page"{% endif %}>Inicio</a>
        <a href="{{ root }}#servicios">Servicios</a>
        <a href="{{ root }}#nosotros">Nosotros</a>
        <a href="{{ root }}#historias">Historias</a>
        <a href="{{ root }}#ubicacion">Encuéntranos</a>
        <a href="{{ path('vet_api.catalog') }}">Tienda {% include '@vet_theme/templates/icon.html.twig' with {icon: 'arrow-up-right'} only %}</a>
        <a class="mobile-contact" href="{{ business.appointment_url }}" target="_blank" rel="noopener noreferrer">Separar cita por WhatsApp</a>
      </nav>
      <div class="header-actions">
        <a class="cart-link" href="{{ path('commerce_cart.page') }}" aria-label="Ver carrito">{% include '@vet_theme/templates/icon.html.twig' with {icon: 'bag'} only %}<span>Carrito</span>{{ cart_count }}</a>
        <a class="button button-small header-appointment" href="{{ business.appointment_url }}" target="_blank" rel="noopener noreferrer">Separar cita {% include '@vet_theme/templates/icon.html.twig' with {icon: 'arrow-up-right'} only %}</a>
      </div>
    </div>
  </header>
  {% if page.highlighted %}<div class="container notices">{{ page.highlighted }}</div>{% endif %}
  <main id="main-content" tabindex="-1"{% if not is_front %} class="container interior-page"{% endif %}>
    {{ page.content }}
  </main>
  <footer class="site-footer">
    <div class="container footer-top">
      <div class="footer-brand"><a class="brand{% if vet_real_logo %} brand-real{% endif %}" href="{{ root }}"><span class="brand-symbol{% if vet_logo_crop %} brand-symbol-wolf{% endif %}"><img src="{{ vet_logo }}" width="48" height="52" alt="" /></span><span><strong>BALTO<span class="brand-dot">.</span></strong><small>VETERINARIA</small></span></a><p>{{ business.slogan }}.<br />Cerca de ti, en Juliaca.</p></div>
      <div><h2>Hablemos</h2><a href="{{ business.appointment_url }}" target="_blank" rel="noopener noreferrer">WhatsApp: {{ business.whatsapp }} ↗</a><a href="{{ business.phone_url }}">Llámanos: {{ business.whatsapp }}</a>{% if business.phone_secondary_url %}<a href="{{ business.phone_secondary_url }}">También: {{ business.phone_secondary }}</a>{% endif %}{% if business.email %}<a href="mailto:{{ business.email }}">{{ business.email }}</a>{% endif %}</div>
      <div><h2>Visítanos</h2>{% for address in business.addresses %}<p>{{ address }}</p>{% endfor %}</div>
      <div><h2>Sigamos cerca</h2>{% if business.facebook_url %}<a href="{{ business.facebook_url }}" target="_blank" rel="noopener noreferrer">{{ business.facebook_name }} en Facebook ↗</a>{% else %}<p>Encuéntranos en Facebook como<br /><strong>{{ business.facebook_name }}</strong>.</p>{% endif %}{% if business.instagram_url %}<a href="{{ business.instagram_url }}" target="_blank" rel="noopener noreferrer">Instagram: @{{ business.instagram_user }} ↗</a>{% endif %}{% if business.tiktok_name %}<p>TikTok: <strong>{{ business.tiktok_name }}</strong></p>{% endif %}<a href="{{ path('user.login') }}">Acceso a mi cuenta ↗</a></div>
    </div>
    <div class="container payment-strip" role="region" aria-label="Medios de pago aceptados">
      <h2>Medios de pago</h2>
      <ul class="payment-strip-list">
        {# Solo lo que el cliente puede usar hoy; PagoEfectivo aparece solo cuando Culqi esté activo. #}
        {% for method in payment_methods|filter(method => method.available) %}
          <li class="payment-chip{% if not method.available %} payment-chip-soon{% endif %}">
            {% include '@vet_theme/templates/icon.html.twig' with {icon: method.icon} only %}
            <span class="payment-chip-text">
              <strong>{{ method.label }}</strong>
              <small>{{ method.note }}</small>
            </span>
            {% if not method.available %}<span class="payment-chip-badge">Próximamente</span>{% endif %}
          </li>
        {% endfor %}
      </ul>
    </div>
    <div class="container footer-bottom"><span>© {{ vet_year }} {{ business.name }}.</span><span>Hecho para quienes son parte de tu familia.</span><a href="{{ path('system.admin') }}">Administración</a></div>
  </footer>
</div>
{% if show_action_bar %}
<nav class="mobile-action-bar" aria-label="Contacto rápido">
  <a class="mobile-action mobile-action-whatsapp" href="{{ business.appointment_url }}" target="_blank" rel="noopener noreferrer">{% include '@vet_theme/templates/icon.html.twig' with {icon: 'whatsapp'} only %}<span>Separar cita</span></a>
  <a class="mobile-action mobile-action-call" href="{{ business.phone_url }}">{% include '@vet_theme/templates/icon.html.twig' with {icon: 'phone'} only %}<span>Llamar</span></a>
</nav>
{% endif %}
<div class="cart-drawer" data-cart-drawer hidden>
  <div class="cart-drawer-backdrop" data-cart-close></div>
  <section class="cart-drawer-panel" role="dialog" aria-modal="true" aria-labelledby="cart-drawer-title" tabindex="-1">
    <header class="cart-drawer-header"><h2 id="cart-drawer-title">Tu carrito</h2><button type="button" class="cart-drawer-close" data-cart-close aria-label="Cerrar carrito">{% include '@vet_theme/templates/icon.html.twig' with {icon: 'close'} only %}</button></header>
    <p class="cart-drawer-status" role="status" aria-live="polite" data-cart-status></p>
    <div class="cart-drawer-body" data-cart-body></div>
    <footer class="cart-drawer-footer" data-cart-footer hidden>
      <p class="cart-drawer-subtotal"><span>Subtotal</span><strong data-cart-subtotal></strong></p>
      <a class="button cart-drawer-checkout" data-cart-checkout href="{{ path('commerce_cart.page') }}">Finalizar compra</a>
      <a class="text-link" data-cart-page href="{{ path('commerce_cart.page') }}">Ver o editar el carrito</a>
    </footer>
  </section>
</div>

{% include '@vet_theme/templates/chat-widget.html.twig' %}
