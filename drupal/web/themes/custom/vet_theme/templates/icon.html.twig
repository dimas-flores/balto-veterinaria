{# Iconos Lucide alojados localmente; el SVG es decorativo. WhatsApp conserva su símbolo existente. #}
{% set lucide_icons = {'arrow-up-right': 'arrow-up-right', 'pin': 'map-pin', 'heart': 'heart', 'bag': 'shopping-bag', 'clock': 'clock', 'menu': 'menu', 'cross': 'cross', 'paw': 'paw-print', 'stethoscope': 'stethoscope', 'xray': 'scan-line', 'ultrasound': 'monitor', 'surgery': 'scissors', 'lab': 'flask-conical', 'bed': 'bed-single', 'moon': 'moon-star', 'chat': 'message-circle', 'search': 'search', 'close': 'x', 'send': 'send', 'arrow-left': 'arrow-left', 'arrow-right': 'arrow-right', 'phone': 'smartphone'} %}
<svg class="icon icon-{{ icon }}" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
{% if lucide_icons[icon] is defined %}{% include '@vet_theme/templates/icons/' ~ lucide_icons[icon] ~ '.svg.twig' %}
{% elseif icon == 'whatsapp' %}<path d="M21 11.5a9 9 0 0 1-13.3 7.9L3 21l1.5-4.6A9 9 0 1 1 21 11.5Z"/><path d="M8 7c0 5 4 9 9 9l1-3-3-1-1 2a9 9 0 0 1-4-4l2-1-1-3-3 1Z"/>
{% else %}{% include '@vet_theme/templates/icons/cross.svg.twig' %}{% endif %}
</svg>
