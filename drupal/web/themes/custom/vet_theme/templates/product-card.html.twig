<article class="product-card" data-sku="{{ item.sku }}"><a class="product-image-link" href="{{ item.url }}" aria-label="Ver {{ item.name }}"><div class="product-image"><img src="{{ item.image_url }}" alt="{{ item.image_alt }}" width="720" height="660" loading="lazy" />{% if not item.available %}<span class="product-status is-sold-out">Agotado</span>{% endif %}</div></a><div class="product-card-body"><span class="product-category">{{ item.category }}</span><h3><a href="{{ item.url }}">{{ item.name }}</a></h3><p class="product-species">{% for label in item.species %}{{ label }}{{ not loop.last ? ' · ' : '' }}{% endfor %}</p><div class="product-price-row"><strong>{{ item.price }}</strong><span class="stock-label{{ not item.available ? ' stock-label-empty' : '' }}">{{ item.available ? item.stock ~ ' disponibles' : 'Sin existencias' }}</span></div>{% if item.cart_form %}<div class="product-card-cart">{{ item.cart_form }}</div>{% else %}<a class="product-detail-link" href="{{ item.url }}">Ver producto <span aria-hidden="true">↗</span></a>{% endif %}</div></article>
