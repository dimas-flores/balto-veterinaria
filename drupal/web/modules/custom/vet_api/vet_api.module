<?php

/**
 * @file
 * Integración de renderizado. Los endpoints JSON se incorporarán en Fase 5.
 */

/** Implements hook_theme(). */
function vet_api_theme(): array {
  return [
    'vet_home' => ['variables' => ['business' => [], 'services' => [], 'clinic_gallery' => []]],
    'vet_catalog' => ['variables' => ['business' => [], 'products' => [], 'total' => 0, 'categories' => [], 'species_options' => [], 'filters' => [], 'pager' => []]],
  ];
}

/** Implements hook_ENTITY_TYPE_view(). */
function vet_api_commerce_product_view(array &$build, \Drupal\commerce_product\Entity\ProductInterface $product): void {
  if ($product->bundle() === 'vet_product') {
    $build['#cache']['tags'][] = 'config:vet_api.business';
    foreach ($product->getVariations() as $variation) {
      $build['#cache']['tags'] = \Drupal\Core\Cache\Cache::mergeTags($build['#cache']['tags'], $variation->getCacheTags());
    }
  }
}

/** Unifica la terminología de la tienda sin reemplazar el formulario Commerce. */
function vet_api_form_commerce_order_item_add_to_cart_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state): void {
  if (isset($form['actions']['submit']) && empty($form['actions']['submit']['#disabled'])) {
    $form['actions']['submit']['#value'] = t('Agregar al carrito');
  }
}

/** Explica la coordinación del pedido y distingue la opción académica. */
function vet_api_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state, string $form_id): void {
  $object = $form_state->getFormObject();
  $checkout = $object instanceof \Drupal\commerce_checkout\Plugin\Commerce\CheckoutFlow\CheckoutFlowInterface;
  $cart = FALSE;
  if ($object instanceof \Drupal\views\Form\ViewsForm) {
    $args = $form_state->getBuildInfo()['args'] ?? [];
    $view = reset($args);
    $cart = $view instanceof \Drupal\views\ViewExecutable && in_array('commerce_cart_form', \Drupal\Component\Utility\Tags::explode($view->storage->get('tag')), TRUE);
  }
  if ($checkout || $cart) {
    $form['vet_demo_notice'] = [
      '#type' => 'container', '#weight' => -100,
      '#attributes' => ['class' => ['checkout-demo-notice']],
      'title' => ['#type' => 'html_tag', '#tag' => 'strong', '#value' => t('Retiro en BALTO · Pago al recoger o Yape coordinado')],
      'description' => ['#type' => 'html_tag', '#tag' => 'p', '#value' => t('BALTO confirmará disponibilidad y total por WhatsApp antes del pago.')],
    ];
  }
  if ($cart) {
    $form['#attributes']['class'][] = 'balto-cart-form';
    $form['output']['#prefix'] = '<div class="cart-table-scroll" tabindex="0" role="region" aria-label="Productos del carrito">';
    $form['output']['#suffix'] = '</div>';
    if (isset($form['actions']['submit'])) {
      $form['actions']['submit']['#value'] = t('Actualizar carrito');
    }
    if (isset($form['actions']['checkout'])) {
      $form['actions']['checkout']['#value'] = t('Finalizar compra');
    }
  }
}

/** Datos del pedido visibles solo después del control de acceso de Commerce. */
function vet_api_commerce_order_view(array &$build, \Drupal\commerce_order\Entity\OrderInterface $order): void {
  if (in_array($order->get('payment_gateway')->target_id, ['pagar_al_recoger', 'yape_coordinado'], TRUE)) {
    $build['vet_manual'] = ['#type' => 'container', '#weight' => -100, '#cache' => ['max-age' => 0], '#attributes' => ['class' => ['checkout-demo-notice']],
      'status' => ['#type' => 'html_tag', '#tag' => 'strong', '#value' => $order->getState()->getId() === 'canceled' ? t('Pedido cancelado — no solicitar pagos') : ($order->isPaid() ? t('Pago registrado por BALTO') : t('Pago pendiente de verificación del establecimiento'))],
      'customer' => ['#type' => 'item', '#title' => t('Datos para coordinar el retiro'), 'value' => ['#plain_text' => $order->getData('vet_customer_name', '') . ' · ' . $order->getData('vet_customer_phone', '')]],
      'instructions' => ['#type' => 'html_tag', '#tag' => 'p', '#value' => t('Verifica el dinero recibido antes de registrar el pago. Las unidades quedan apartadas al registrar el pedido y se devuelven al stock al cancelarlo. No se descuentan otra vez al recibir el pago.')],
    ];
  }
  if ($order->getData('vet_simulated')) {
    $build['vet_demo'] = ['#type' => 'container', '#weight' => -100, '#attributes' => ['class' => ['checkout-demo-notice']],
      'notice' => ['#type' => 'html_tag', '#tag' => 'strong', '#value' => t('Pago simulado – No se realiza ningún cobro real')],
      'customer' => ['#type' => 'item', '#title' => t('Datos para el retiro'), 'value' => ['#plain_text' => $order->getData('vet_customer_name', '') . ' · ' . $order->getData('vet_customer_phone', '')]],
    ];
  }
}

/** Asigna el rol de cliente a cuentas nuevas; nunca concede administración. */
function vet_api_user_presave(\Drupal\user\UserInterface $account): void {
  if ($account->isNew() && \Drupal\user\Entity\Role::load('cliente') && !$account->hasRole('administrador_tienda')) {
    $account->addRole('cliente');
  }
}

/** Conserva la validación numérica nativa y evita ajustes de saldo negativo. */
function vet_api_field_widget_single_element_form_alter(array &$element, \Drupal\Core\Form\FormStateInterface $form_state, array $context): void {
  $items = $context['items'];
  $entity = $items->getEntity();
  if ($items->getName() === 'field_stock_level' && $entity->getEntityTypeId() === 'commerce_product_variation' && $entity->bundle() === 'vet_variation' && isset($element['adjustment'])) {
    $element['adjustment']['#vet_variation_id'] = $entity->id();
    $element['adjustment']['#element_validate'] = [
      [\Drupal\Core\Render\Element\Number::class, 'validateNumber'],
      'vet_api_stock_adjustment_validate',
    ];
  }
}

function vet_api_stock_adjustment_validate(array &$element, \Drupal\Core\Form\FormStateInterface $form_state): void {
  $value = $form_state->getValue($element['#parents']);
  if ($value === '' || !is_numeric($value)) {
    return;
  }
  $variation = $element['#vet_variation_id'] ? \Drupal::entityTypeManager()->getStorage('commerce_product_variation')->load($element['#vet_variation_id']) : NULL;
  $stock = $variation ? \Drupal::service('vet_api.catalog')->stock($variation) : 0;
  if ($stock + (float) $value < 0) {
    $form_state->setError($element, t('El ajuste dejaría existencias negativas. El saldo actual es @stock.', ['@stock' => $stock]));
  }
}

/** Implements hook_page_attachments(). */
function vet_api_page_attachments(array &$attachments): void {
  // El contacto también aparece en cabecera y pie: invalidar toda página cacheada.
  $attachments['#cache']['tags'][] = 'config:vet_api.business';
  $attachments['#cache']['tags'] = array_merge($attachments['#cache']['tags'], \Drupal::service('vet_api.clinic_gallery')->get()['cache_tags']);
  $attachments['#attached']['drupalSettings']['baltoChat'] = [
    'webhookUrl' => \Drupal\Core\Site\Settings::get('vet_chat_webhook_url', ''),
  ];
}

/** Identifica el medio en el pedido, conservando el historial de las demos previas. */
function vet_api_commerce_order_presave(\Drupal\commerce_order\Entity\OrderInterface $order): void {
  $gateway = $order->get('payment_gateway')->target_id;
  if ($gateway && in_array($gateway, ['pago_simulado', 'pagar_al_recoger', 'yape_coordinado'], TRUE)) {
    $order->setData('vet_simulated', $gateway === 'pago_simulado');
  }
}

/** Un pago cancelado no puede confirmarse como recibido por accidente. */
function vet_api_commerce_payment_presave(\Drupal\commerce_payment\Entity\PaymentInterface $payment): void {
  $order = $payment->getOrder();
  if ($order && $order->getState()->getId() === 'canceled' && $payment->getState()->getId() === 'completed') {
    throw new \Drupal\commerce_payment\Exception\PaymentGatewayException('El pedido está cancelado. No se puede registrar un pago recibido.');
  }
}
