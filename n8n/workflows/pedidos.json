{
  "id": "baltoPedidos",
  "name": "BALTO · Avisos por Telegram (pedidos y stock bajo)",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "all",
    "saveManualExecutions": false,
    "executionTimeout": 30
  },
  "tags": [],
  "nodes": [
    {
      "id": "Recibir pedido",
      "name": "Recibir pedido",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "balto-pedido",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "baltoPedidoSecret",
          "name": "BALTO secreto de pedidos"
        }
      },
      "webhookId": "balto-pedido-webhook"
    },
    {
      "id": "Armar mensaje",
      "name": "Armar mensaje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        300
      ],
      "parameters": {
        "jsCode": "const o = $input.first().json.body || {};\nconst esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst items = Array.isArray(o.items) ? o.items.slice(0, 20) : [];\nconst lines = items.map(i => `• ${esc(i.quantity)} × ${esc(i.title)}`).join('\\n');\nconst text = `🛒 <b>Pedido nuevo #${esc(o.order_number)}</b>\\n\\n${lines}\\n\\n<b>Total:</b> ${esc(o.currency)} ${esc(o.total)}\\n<b>Pago:</b> ${esc(o.payment_method) || 'sin definir'}\\n<b>Cliente:</b> ${esc(o.email) || 'sin correo'}`;\nreturn [{ json: { text } }];"
      }
    },
    {
      "id": "Avisar por Telegram",
      "name": "Avisar por Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        520,
        300
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "__TELEGRAM_CHAT_ID__",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "parse_mode": "HTML",
          "appendAttribution": false
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "baltoTelegram",
          "name": "BALTO Telegram"
        }
      }
    },
    {
      "id": "Cada día",
      "name": "Cada día",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        560
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 9
            }
          ]
        }
      }
    },
    {
      "id": "Leer productos",
      "name": "Leer productos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        560
      ],
      "parameters": {
        "url": "http://drupal/api/vet/products",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 8000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "pagination": {
            "pagination": {
              "paginationMode": "updateAParameterInEachRequest",
              "parameters": {
                "parameters": [
                  {
                    "type": "qs",
                    "name": "page",
                    "value": "={{ $pageCount }}"
                  }
                ]
              },
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ $response.body.data.length < 50 }}",
              "limitPagesFetched": true,
              "maxRequests": 20
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "baltoDrupalApi",
          "name": "BALTO API interna"
        }
      }
    },
    {
      "id": "Filtrar stock bajo",
      "name": "Filtrar stock bajo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        560
      ],
      "parameters": {
        "jsCode": "const threshold = __STOCK_THRESHOLD__;\nconst esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst rows = $input.all().flatMap(i => Array.isArray(i.json.data) ? i.json.data : []);\nconst low = rows.filter(p => Number.isFinite(p.stock) && p.stock <= threshold).sort((a, b) => a.stock - b.stock);\nif (!low.length) return [];\nconst lines = low.slice(0, 30).map(p => `• ${esc(p.name)} (${esc(p.sku)}): ${p.stock <= 0 ? '<b>agotado</b>' : p.stock + ' u.'}`).join('\\n');\nconst more = low.length > 30 ? `\\n… y ${low.length - 30} más` : '';\nreturn [{ json: { text: `📦 <b>Stock bajo</b> (${low.length} de ${rows.length} productos, umbral ${threshold})\\n\\n${lines}${more}` } }];"
      }
    },
    {
      "id": "Avisar stock bajo",
      "name": "Avisar stock bajo",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        780,
        560
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "__TELEGRAM_CHAT_ID__",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "parse_mode": "HTML",
          "appendAttribution": false
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "baltoTelegram",
          "name": "BALTO Telegram"
        }
      }
    }
  ],
  "connections": {
    "Recibir pedido": {
      "main": [
        [
          {
            "node": "Armar mensaje",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Armar mensaje": {
      "main": [
        [
          {
            "node": "Avisar por Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Cada día": {
      "main": [
        [
          {
            "node": "Leer productos",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Leer productos": {
      "main": [
        [
          {
            "node": "Filtrar stock bajo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filtrar stock bajo": {
      "main": [
        [
          {
            "node": "Avisar stock bajo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}